@@ -69,6 +69,18 @@

 #include "absl/base/nullability.h"

+// abseil >= 20250814 replaced Nullable<T>/Nonnull<T> type aliases with
+// absl_nullable/absl_nonnull pointer-annotation macros. ABSL_POINTERS_DEFAULT_NONNULL
+// is defined only in the new-style headers; use it to detect and bridge the gap.
+#ifdef ABSL_POINTERS_DEFAULT_NONNULL
+namespace absl {
+template <typename T>
+using Nullable = T;
+template <typename T>
+using Nonnull = T;
+template <typename T>
+using NullabilityUnknown = T;
+}  // namespace absl
+#endif
